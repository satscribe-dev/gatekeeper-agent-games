# Copy to .env — never commit .env. The HMAC secret is issued once at
# agent registration (dashboard) and shown exactly once.
PORT=8788
AGENT_HMAC_SECRET=
# Optional (read-only on-chain cross-check):
# ZKVERIFY_RPC_URL=wss://zkverify-rpc.zkverify.io
# ONCHAIN_TIMEOUT_MS=5000
# Optional (Kurier proof submission — only if a key is issued):
# KURIER_API_KEY=
# KURIER_API_URL=https://api-testnet.kurier.xyz/api/v1
